/* ============================================
   Study.Table() — Главный файл стилей
   Тёмная тема с акцентами
   ============================================ */

/* --- Глобальные стили (тёмный фон, как на макетах) --- */
QWidget {
    background-color: #050816;
    color: #cdd6f4;
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
    font-size: 14px;
}

/* --- Кнопки --- */
QPushButton {
    background-color: #151827;
    color: #cdd6f4;
    border: 1px solid #2b3048;
    border-radius: 999px;
    padding: 10px 24px;
    font-weight: bold;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #1e2236;
    border: 1px solid #8b9bff;
}

QPushButton:pressed {
    background-color: #313244;
}

/* Основная кнопка (синяя, как на Sign in) */
QPushButton#primaryButton,
QPushButton[primary="true"] {
    background-color: #2f73ff;
    color: #0b1020;
    border: none;
    box-shadow: 0px 18px 40px rgba(47, 115, 255, 0.45);
}

QPushButton#primaryButton:hover,
QPushButton[primary="true"]:hover {
    background-color: #3f82ff;
}

/* Кнопка удаления (красная) */
QPushButton#deleteButton,
QPushButton[danger="true"] {
    background-color: #f38ba8;
    color: #1e1e2e;
    border: none;
}

QPushButton#deleteButton:hover,
QPushButton[danger="true"]:hover {
    background-color: #eba0ac;
}

/* Кнопка успеха (зелёная) */
QPushButton[success="true"] {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
}

QPushButton[success="true"]:hover {
    background-color: #94e2d5;
}

/* --- Поля ввода --- */
QLineEdit, QTextEdit, QSpinBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 2px solid #89b4fa;
}

/* --- Выпадающий список --- */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 24px;
}

QComboBox:hover {
    border: 2px solid #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #585b70;
    selection-background-color: #45475a;
}

/* --- Таблицы --- */
QTableWidget, QTableView {
    background-color: #090c1a;
    alternate-background-color: #101321;
    color: #cdd6f4;
    gridline-color: #313244;
    border: 1px solid #313244;
    border-radius: 8px;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
}

QTableWidget::item, QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #313244;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #45475a;
}

QHeaderView::section {
    background-color: #101321;
    color: #8b9bff;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #89b4fa;
    font-weight: bold;
}

/* --- Вкладки (TabWidget) --- */
QTabWidget::pane {
    background-color: #050816;
    border: 1px solid #313244;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #101321;
    color: #8b9bff;
    padding: 10px 24px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #050816;
    color: #ffffff;
    border-bottom: 2px solid #2f73ff;
}

QTabBar::tab:hover:!selected {
    background-color: #45475a;
    color: #cdd6f4;
}

/* --- Надписи --- */
QLabel {
    color: #cdd6f4;
    background: transparent;
}

QLabel#titleLabel {
    font-size: 28px;
    font-weight: bold;
    color: #2f73ff;
}

QLabel#subtitleLabel {
    font-size: 16px;
    color: #a6adc8;
}

QLabel#statValue {
    font-size: 32px;
    font-weight: bold;
    color: #f9e2af;
}

QLabel#statLabel {
    font-size: 12px;
    color: #a6adc8;
}

QLabel#errorLabel {
    color: #f38ba8;
    font-weight: bold;
}

QLabel#successLabel {
    color: #a6e3a1;
    font-weight: bold;
}

/* --- Группировочные рамки --- */
QGroupBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
    margin-top: 16px;
    padding: 16px;
    padding-top: 28px;
    font-weight: bold;
    color: #cdd6f4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #89b4fa;
}

/* --- Полоса прокрутки --- */
QScrollBar:vertical {
    background-color: #181825;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #181825;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 5px;
    min-width: 30px;
}

/* --- Диалоговые окна --- */
QDialog {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 12px;
}

/* --- Меню --- */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
}

QMenuBar::item:selected {
    background-color: #45475a;
}

QMenu {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #45475a;
    border-radius: 4px;
}

/* --- Статусбар --- */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
}

/* --- Карточки статистики (custom) --- */
QFrame#statCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 16px;
}

QFrame#statCard:hover {
    border: 1px solid #89b4fa;
}

/* --- Разделитель --- */
QFrame[frameShape="4"] {
    color: #313244;
    max-height: 1px;
}

/* --- Подсказки --- */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px;
}
